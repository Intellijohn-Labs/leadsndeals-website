# Copy to .env.local and fill in. Never commit .env.local.
# On the VPS: create .env.local in the project folder BEFORE running `npm run build`.

# Claude API key for Lia, the website assistant (/api/chat).
# A project-specific name so a shell-level ANTHROPIC_API_KEY can't shadow it.
LEADSNDEALS_ANTHROPIC_API_KEY=

# Gemini key for voice input in Malayalam (/api/transcribe, gemini-3.1-flash-lite).
GEMINI_API_KEY=

# Where demo-form bookings are sent: n8n workflow "Leadsndeals - Website Demo Booking"
# (saves the lead in Work OS + sends the WhatsApp confirmation and team alert).
LEAD_WEBHOOK_URL=https://n8n.srv1691210.hstgr.cloud/webhook/leadsndeals-demo-form
# Optional shared secret sent as X-Webhook-Secret
LEAD_WEBHOOK_SECRET=

# The public address of the site (canonical link, sitemap, Google data).
# Set it to the real domain on the VPS. It is baked in at build time, so rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://leadsndeals.com

# Spoken replies are switched off (cost). Set to 1 only if you want /api/tts back.
IRA_TTS_ENABLED=
