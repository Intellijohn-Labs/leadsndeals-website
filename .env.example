# Copy to .env.local and fill in. Never commit .env.local.

# Claude API key for the website assistant (Ira).
# A project-specific name so a shell-level ANTHROPIC_API_KEY can't shadow it.
LEADSNDEALS_ANTHROPIC_API_KEY=

# Gemini key: Ira's spoken voice (/api/tts, gemini-3.8-flash-lite-tts, voice Kore).
# Also used offline to generate her portrait/videos (Gemini Omni, paid tier).
GEMINI_API_KEY=

# Where demo-form leads are sent (e.g. an n8n webhook that saves to CRM/Sheet + alerts WhatsApp).
LEAD_WEBHOOK_URL=
# Optional shared secret sent as X-Webhook-Secret
LEAD_WEBHOOK_SECRET=
